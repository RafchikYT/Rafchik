# Номер владельца магазина в формате <код страны><номер>@c.us, например 79991234567@c.us
OWNER_NUMBER=79991234567@c.us

# Название магазина, адрес и часы работы для авто-ответов
SHOP_NAME=Магазин "Пример"
SHOP_ADDRESS=г. Москва, ул. Примерная, д. 1
SHOP_HOURS=с 10:00 до 20:00 без выходных

# --- Рассылка NFC-визиток бизнесам Риги ---

# Токен Telegram-бота для управления рассылкой (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID владельца — бот будет отвечать только на команды из этого чата
# (узнать свой id можно у @userinfobot)
TELEGRAM_OWNER_CHAT_ID=

# Лимиты автоотправки, чтобы снизить риск бана WhatsApp-номера
OUTREACH_DAILY_LIMIT=30
OUTREACH_MIN_DELAY_SEC=45
OUTREACH_MAX_DELAY_SEC=120

# Центр поиска бизнесов (по умолчанию — центр Риги) и радиус поиска в метрах
RIGA_CENTER_LAT=56.9496
RIGA_CENTER_LON=24.1052
SEARCH_RADIUS_M=8000
